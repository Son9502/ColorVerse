rules_version = '2';

// ColorVerse (v1.6). Scores are written only by the Cloud Functions (functions/src/index.js), which
// replay each round first; the admin SDK they use isn't bound by these rules. The browser may read
// its own data and the public daily leaderboard, and set its own nickname.
service cloud.firestore {
  match /databases/{database}/documents {

    function validNickname(data) {
      return data.keys().hasOnly(["nickname", "bests"])
        && data.nickname is string
        && data.nickname.size() >= 2 && data.nickname.size() <= 20;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nickname"]) && validNickname(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nickname"])
        && validNickname(request.resource.data);

      match /{collection}/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /dailies/{day}/scores/{uid} {
      allow read: if true;
    }
  }
}
